# Copy to .env and adjust. Every value has a working default, so an empty .env
# is fine for a local run.

# Host port for the API and admin UI.
HOMESYNC_PORT=8420

# Where the synced files live, and where the index lives. Relative paths are
# resolved against this directory.
HOMESYNC_DATA=./data
HOMESYNC_CONFIG=./config

# Set a password to enable the web admin UI at http://localhost:8420/.
# Leave empty and no management routes are registered at all.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Serve the admin UI with no login at all. Anyone who can reach the port can
# then issue device tokens, read every filename, and empty the trash.
ADMIN_NO_AUTH=

# Encrypt file contents at rest. Generate one with:
#   docker compose run --rm homesync key generate
# Empty means the volume holds plaintext, which is the default. Lose this key
# and the files written under it cannot be read back.
ENCRYPTION_KEY=

# Days before discarded content is purged from the trash.
TRASH_DAYS=30

# Days before delete markers are dropped. A client offline longer than this
# has to resync from scratch.
TOMBSTONE_DAYS=90

# How often the server reconciles its index against the actual filesystem.
RESCAN_INTERVAL=15m

TZ=America/Sao_Paulo
LOG_LEVEL=info

# ── Backups ──────────────────────────────────────────────────────────────────
# Dated snapshots of a directory onto another disk, taken by the server itself.
#
# The first three say where things are, and are read on every start: moving a
# mount has to move the path with it. The admin page shows them and does not
# offer to edit them. The last two seed the first start only — from the first
# save on that page onwards, the page owns them.

# What gets copied. Mounted read-only at /backup-source in the container, which
# is where the server looks without being told. Defaults to the synced files;
# point it anywhere else worth keeping and the backup follows.
HOMESYNC_BACKUP_SOURCE=./data

# The host directory the snapshots are written to. Point it at the mountpoint
# of the disk that holds them; it is bind-mounted at /backup in the container.
HOMESYNC_BACKUP=./backup

# A file that exists only on the real backup disk, created once with the disk
# mounted:  touch /mnt/Storage/Backup/.homesync_backup_disk
# Without it a run aborts before writing anything — see the README, because a
# bind mount is always a mountpoint inside the container and proves nothing.
BACKUP_MARKER=.homesync_backup_disk

# The admin page shows the host paths above rather than /backup-source and
# /backup. It has to be told them: a container sees only its own mount points,
# and which host directory a bind mount put there is a fact that exists outside
# it. Display only — nothing is read or written under these names.

# Whether backups run, and when.
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 3 * * *

# Retention is set on the admin page, next to the snapshots it applies to: it
# keeps the N most recent runs, the newest snapshot of each of the last N ISO
# weeks and the newest of each of the last N months. BACKUP_DAILY,
# BACKUP_WEEKLY and BACKUP_MONTHLY can seed it on a first start — see
# `homesync help` — but there is rarely a reason to.
